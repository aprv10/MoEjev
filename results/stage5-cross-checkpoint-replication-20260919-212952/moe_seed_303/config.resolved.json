{
  "experiment": {
    "name": "stage5-moe-seed-303",
    "seed": 303,
    "output_dir": "results"
  },
  "data": {
    "dataset": "wikitext-2-raw-v1",
    "cache_dir": "data/cache",
    "max_train_tokens": 2000000,
    "max_validation_tokens": 262144
  },
  "model": {
    "sequence_length": 128,
    "num_layers": 4,
    "model_dim": 256,
    "num_heads": 4,
    "dense_hidden_dim": 1024,
    "expert_hidden_dim": 1024,
    "num_experts": 4,
    "moe_layers": [
      1,
      3
    ],
    "dropout": 0.1
  },
  "router": {
    "type": "baseline_top_k",
    "top_k": 2,
    "load_balance_weight": 0.01,
    "z_loss_weight": 0.001
  },
  "training": {
    "batch_size": 4,
    "gradient_accumulation_steps": 8,
    "max_steps": 1000,
    "warmup_steps": 50,
    "learning_rate": 0.0003,
    "weight_decay": 0.1,
    "betas": [
      0.9,
      0.95
    ],
    "max_gradient_norm": 1.0,
    "mixed_precision": "fp16",
    "num_workers": 0,
    "log_every": 10,
    "validation_batches": 50
  }
}